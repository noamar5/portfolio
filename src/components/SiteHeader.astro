---
import type { Locale } from "../i18n/locales";
import { localizePath } from "../i18n/paths";
import { t, type UiKey } from "../i18n/ui";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const home = localizePath("/", locale);

// Anchors of the home page sections, identical in every locale.
const sections: { anchor: string; label: UiKey }[] = [
  { anchor: "work", label: "nav.work" },
  { anchor: "method", label: "nav.method" },
  { anchor: "experience", label: "nav.experience" },
  { anchor: "contact", label: "nav.contact" },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={home}>
      <span class="mark" aria-hidden="true">NM</span>
      <span class="name">Noa Marchionni<span class="visually-hidden">, {t(locale, "header.home")}</span></span>
    </a>

    <nav class="site-nav" aria-label={t(locale, "nav.label")}>
      <ul role="list">
        {
          sections.map(({ anchor, label }) => (
            <li>
              <a href={`${home}#${anchor}`}>{t(locale, label)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="language">
      <LanguageSwitch locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /*
   * Two rows on small screens, without JavaScript: brand and language
   * switch first, then the four section links on their own row.
   */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target-min);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .mark {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
  }

  .site-nav {
    order: 3;
    flex-basis: 100%;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-2);
  }

  .site-nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--target-min);
    min-height: var(--target-min);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .language {
    order: 2;
  }

  /* 720px: one row, as in the mockup. */
  @media (min-width: 45rem) {
    .inner {
      gap: var(--space-4) var(--space-7);
      padding-block: var(--space-4);
    }

    .site-nav {
      order: 2;
      flex-basis: auto;
      margin-inline-start: auto;
    }

    .site-nav ul {
      gap: var(--space-5);
    }

    .language {
      order: 3;
    }
  }
</style>
