---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { defaultLocale, isLocale, locales, stripLocale } from "../i18n/locales";

interface Props {
  title: string;
  description: string;
  /** Set to false on pages without a canonical URL, such as error pages. */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const path = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Provisional empty favicon, avoids a 404 request until the real one exists. */}
    <link rel="icon" href="data:," />
    {
      indexable && (
        <>
          <link rel="canonical" href={getAbsoluteLocaleUrl(locale, path)} />
          {locales.map((alternate) => (
            <link rel="alternate" hreflang={alternate} href={getAbsoluteLocaleUrl(alternate, path)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
        </>
      )
    }
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
