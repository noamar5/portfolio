---
import geistFontUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { defaultLocale, isLocale, locales } from "../i18n/locales";
import { localizePath } from "../i18n/paths";
import { t } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Set to false on pages without a canonical URL, such as error pages. */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const absoluteUrl = (target: typeof locale) => new URL(localizePath(Astro.url.pathname, target), Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Provisional empty favicon, avoids a 404 request until the real one exists. */}
    <link rel="icon" href="data:," />
    {/* The text font is needed for the first paint; Geist Mono can wait. */}
    <link rel="preload" href={geistFontUrl} as="font" type="font/woff2" crossorigin />
    {
      indexable && (
        <>
          <link rel="canonical" href={absoluteUrl(locale)} />
          {locales.map((alternate) => (
            <link rel="alternate" hreflang={alternate} href={absoluteUrl(alternate)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultLocale)} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">{t(locale, "skip.toContent")}</a>
    <SiteHeader locale={locale} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
